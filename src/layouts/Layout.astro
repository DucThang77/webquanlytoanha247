---
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = `${site.name} | ${site.tagline}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const nav = [
	{ href: '/#dich-vu', label: 'Dịch vụ' },
	{ href: '/#tieu-chuan', label: 'Tiêu chuẩn' },
	{ href: '/#loai-hinh', label: 'Loại hình' },
	{ href: '/#quy-trinh', label: 'Quy trình' },
	{ href: '/#hoi-dap', label: 'Hỏi đáp' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: site.name,
	legalName: site.legalName,
	url: site.url,
	description: site.description,
	email: site.email || undefined,
	telephone: site.phone || undefined,
	address: site.address || undefined,
	openingHours: 'Mo-Su 00:00-23:59',
	areaServed: 'VN',
};
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b2545" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="vi_VN" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#noi-dung">Bỏ qua điều hướng</a>
		<header class="header">
			<div class="container header-inner">
				<a class="brand" href="/" aria-label={site.name}>
					<img src="/favicon.svg" alt="" width="36" height="36" />
					<span>{site.name}</span>
				</a>
				<nav class="nav" aria-label="Điều hướng chính">
					{nav.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<a class="btn btn-gold btn-sm" href="/#lien-he">Nhận tư vấn</a>
			</div>
		</header>

		<main id="noi-dung">
			<slot />
		</main>

		<footer class="footer">
			<div class="container footer-grid">
				<div>
					<div class="brand brand-light">
						<img src="/favicon.svg" alt="" width="36" height="36" />
						<span>{site.name}</span>
					</div>
					<p>{site.legalName}</p>
					<p>{site.tagline}.</p>
				</div>
				<div>
					<h3>Dịch vụ</h3>
					<ul>
						<li><a href="/#dich-vu">Quản lý vận hành tòa nhà</a></li>
						<li><a href="/#dich-vu">Kỹ thuật và bảo trì</a></li>
						<li><a href="/#dich-vu">An ninh, vệ sinh, cảnh quan</a></li>
						<li><a href="/#dich-vu">Tài chính và báo cáo</a></li>
					</ul>
				</div>
				<div>
					<h3>Liên hệ</h3>
					<ul>
						{site.phone && <li>Hotline: <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>}
						{site.email && <li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>}
						{site.address && <li>Địa chỉ: {site.address}</li>}
						<li>{site.hours}</li>
					</ul>
				</div>
			</div>
			<div class="container footer-bottom">
				© {new Date().getFullYear()} {site.legalName} ({site.name}). Bảo lưu mọi quyền.
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--navy: #0b2545;
		--navy-2: #13315c;
		--gold: #c9a227;
		--gold-dark: #a8861b;
		--ink: #1b2430;
		--muted: #5b6676;
		--line: #e3e8ef;
		--bg: #ffffff;
		--bg-soft: #f5f7fa;
		--radius: 10px;
		--font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 84px;
	}
	body {
		margin: 0;
		font-family: var(--font);
		color: var(--ink);
		background: var(--bg);
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}
	h1,
	h2,
	h3 {
		line-height: 1.25;
		margin: 0 0 0.6em;
		color: var(--navy);
	}
	p {
		margin: 0 0 1em;
	}
	a {
		color: inherit;
	}
	img {
		max-width: 100%;
	}
	.container {
		width: min(1140px, 100% - 40px);
		margin-inline: auto;
	}
	.skip {
		position: absolute;
		left: -9999px;
	}
	.skip:focus {
		left: 12px;
		top: 12px;
		background: #fff;
		padding: 8px 12px;
		z-index: 100;
	}
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.96);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 68px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--navy);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand-light {
		color: #fff;
		margin-bottom: 12px;
	}
	.nav {
		display: flex;
		gap: 22px;
		margin-left: auto;
	}
	.nav a {
		text-decoration: none;
		font-size: 0.95rem;
		color: var(--ink);
	}
	.nav a:hover {
		color: var(--gold-dark);
	}
	.btn {
		display: inline-block;
		padding: 14px 26px;
		border-radius: var(--radius);
		font-weight: 600;
		text-decoration: none;
		border: 2px solid transparent;
		cursor: pointer;
		font-size: 1rem;
		font-family: inherit;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.btn-sm {
		padding: 9px 18px;
		font-size: 0.92rem;
	}
	.btn-gold {
		background: var(--gold);
		color: var(--navy);
	}
	.btn-gold:hover {
		background: var(--gold-dark);
		color: #fff;
	}
	.btn-outline {
		border-color: rgba(255, 255, 255, 0.6);
		color: #fff;
	}
	.btn-outline:hover {
		background: #fff;
		color: var(--navy);
	}
	.footer {
		background: var(--navy);
		color: #c8d3e3;
		padding-top: 56px;
		font-size: 0.95rem;
	}
	.footer h3 {
		color: #fff;
		font-size: 1rem;
	}
	.footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.footer li {
		margin-bottom: 8px;
	}
	.footer a {
		text-decoration: none;
	}
	.footer a:hover {
		color: var(--gold);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 40px;
		padding-bottom: 40px;
	}
	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding: 18px 0;
		font-size: 0.85rem;
	}
	@media (max-width: 860px) {
		.nav {
			display: none;
		}
		.header-inner .btn {
			margin-left: auto;
		}
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
</style>
