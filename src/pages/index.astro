---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const services = [
	{
		title: 'Quản lý vận hành tổng thể',
		text: 'Một đầu mối chịu trách nhiệm toàn bộ tòa nhà: nhân sự, nhà thầu, ngân sách, quy chế và quan hệ với cư dân, khách thuê.',
	},
	{
		title: 'Kỹ thuật và bảo trì phòng ngừa',
		text: 'Điện, nước, điều hòa, thang máy, PCCC được bảo trì theo lịch định kỳ, có nhật ký thiết bị, không đợi hỏng mới sửa.',
	},
	{
		title: 'An ninh và an toàn',
		text: 'Kiểm soát ra vào, giám sát camera, tuần tra theo tuyến, diễn tập PCCC và kịch bản ứng phó sự cố cho từng tòa nhà.',
	},
	{
		title: 'Vệ sinh và cảnh quan',
		text: 'Làm sạch theo khu vực và tần suất, kiểm tra chéo bằng bảng chấm điểm, chăm sóc cây xanh, kiểm soát côn trùng.',
	},
	{
		title: 'Chăm sóc cư dân và khách thuê',
		text: 'Lễ tân, tiếp nhận yêu cầu đa kênh, cam kết thời gian phản hồi, khảo sát mức độ hài lòng định kỳ.',
	},
	{
		title: 'Tài chính và báo cáo',
		text: 'Lập ngân sách vận hành năm, thu phí, kiểm soát chi, báo cáo hàng tháng rõ từng khoản cho chủ đầu tư và ban quản trị.',
	},
	{
		title: 'Quản lý năng lượng',
		text: 'Theo dõi tiêu thụ điện nước, đề xuất giải pháp tiết kiệm, hỗ trợ lộ trình công trình xanh và báo cáo ESG.',
	},
	{
		title: 'Tư vấn tiền vận hành',
		text: 'Tham gia từ giai đoạn thiết kế và bàn giao: rà soát công năng, lập quy trình, dự toán phí quản lý, tiếp nhận tòa nhà.',
	},
];

const usStandards = [
	'Báo cáo tài chính và vận hành hàng tháng, số liệu kiểm tra được',
	'Chỉ số đo lường (KPI) và cam kết mức dịch vụ (SLA) ghi rõ trong hợp đồng',
	'Ngân sách năm được phê duyệt trước, chi vượt phải có giải trình',
	'Đấu thầu nhà thầu phụ công khai, so sánh tối thiểu ba báo giá',
	'Quản lý rủi ro, bảo hiểm và tuân thủ pháp lý theo danh mục kiểm tra',
];

const jpStandards = [
	'5S tại phòng kỹ thuật, kho và khu vực công cộng',
	'Kaizen: mỗi sự cố là một cải tiến quy trình được ghi lại',
	'Bảo trì phòng ngừa, kéo dài tuổi thọ thiết bị thay vì thay mới',
	'Omotenashi: phục vụ tận tâm, chỉn chu từ lời chào ở sảnh',
	'Chuẩn bị ứng phó thiên tai, cháy nổ, mất điện bằng diễn tập thật',
];

const propertyTypes = [
	{ title: 'Tòa nhà văn phòng', text: 'Giữ chân khách thuê bằng vận hành ổn định và hình ảnh chuyên nghiệp.' },
	{ title: 'Chung cư, khu căn hộ', text: 'Minh bạch quỹ vận hành, đồng hành cùng ban quản trị và cư dân.' },
	{ title: 'Trung tâm thương mại', text: 'Vận hành an toàn giờ cao điểm, hỗ trợ gian hàng và sự kiện.' },
	{ title: 'Tổ hợp đa chức năng', text: 'Phân tách chi phí, quy chế rõ ràng giữa các khối công năng.' },
	{ title: 'Nhà xưởng, kho vận', text: 'Bảo trì hạ tầng, an ninh và an toàn lao động cho khu sản xuất.' },
	{ title: 'Căn hộ dịch vụ, khách sạn', text: 'Tiêu chuẩn dịch vụ lưu trú kết hợp kỷ luật kỹ thuật tòa nhà.' },
];

const steps = [
	{ title: 'Khảo sát', text: 'Đánh giá hiện trạng kỹ thuật, nhân sự, chi phí và mong muốn của chủ đầu tư.' },
	{ title: 'Đề xuất', text: 'Phương án vận hành, sơ đồ nhân sự, ngân sách năm và bộ KPI đi kèm.' },
	{ title: 'Tiếp nhận', text: 'Bàn giao hồ sơ, kiểm kê thiết bị, chuyển giao nhà thầu, không gián đoạn dịch vụ.' },
	{ title: 'Vận hành', text: 'Trung tâm túc trực 24/7, kiểm tra hàng ngày, bảo trì theo lịch.' },
	{ title: 'Báo cáo, cải tiến', text: 'Báo cáo tháng, họp đánh giá quý, điều chỉnh kế hoạch theo số liệu.' },
];

const faqs = [
	{
		q: 'Phí quản lý được tính như thế nào?',
		a: 'Phí phụ thuộc diện tích, loại hình, hiện trạng thiết bị và phạm vi dịch vụ. Sau khi khảo sát, chúng tôi gửi bảng dự toán chi tiết từng hạng mục để quý khách so sánh.',
	},
	{
		q: 'Tòa nhà đang có đơn vị quản lý khác, chuyển đổi có gián đoạn không?',
		a: 'Không. Chúng tôi lập kế hoạch tiếp nhận theo từng mốc, chạy song song trong giai đoạn bàn giao để dịch vụ cho cư dân và khách thuê diễn ra bình thường.',
	},
	{
		q: 'Chủ đầu tư nhận được báo cáo gì và khi nào?',
		a: 'Báo cáo vận hành và tài chính hàng tháng, gồm thu chi, tình trạng thiết bị, sự cố, yêu cầu của khách hàng và kết quả KPI. Mỗi quý có buổi họp đánh giá.',
	},
	{
		q: 'Khi có sự cố ngoài giờ thì ai xử lý?',
		a: 'Trung tâm vận hành túc trực 24 giờ mỗi ngày, kể cả lễ Tết. Sự cố được phân loại mức độ và xử lý theo thời gian cam kết trong hợp đồng.',
	},
	{
		q: 'Có thể chỉ thuê một phần dịch vụ không?',
		a: 'Có. Quý khách có thể chọn gói tổng thể hoặc từng mảng riêng như kỹ thuật, an ninh, vệ sinh, hoặc tư vấn thiết lập bộ máy vận hành.',
	},
];
---

<Layout>
	<section class="hero">
		<div class="hero-art" aria-hidden="true">
			<span class="ring ring-1"></span>
			<span class="ring ring-2"></span>
			<span class="dot"></span>
			<img src="/logo-mark.jpg" alt="" width="300" height="300" />
		</div>
		<div class="container hero-inner">
			<p class="eyebrow">{site.slogan} · Quản lý vận hành bất động sản</p>
			<h1>Tòa nhà vận hành êm, tài sản giữ giá, cư dân an tâm</h1>
			<p class="lead">
				{site.name} quản lý tòa nhà theo kỷ luật quản trị của Mỹ và tinh thần dịch vụ của Nhật Bản.
				Túc trực 24 giờ mỗi ngày, mọi con số đều có báo cáo.
			</p>
			<div class="hero-cta">
				<a class="btn btn-lime" href="#lien-he">Yêu cầu khảo sát miễn phí</a>
				{site.phone && <a class="btn btn-outline" href={`tel:${site.phone.replace(/\s/g, '')}`}>Gọi {site.phone}</a>}
				<a class="btn btn-outline" href="#dich-vu">Xem dịch vụ</a>
			</div>
			<ul class="hero-points">
				<li><strong>24/7</strong><span>Trung tâm vận hành túc trực</span></li>
				<li><strong>KPI + SLA</strong><span>Cam kết ghi trong hợp đồng</span></li>
				<li><strong>Hàng tháng</strong><span>Báo cáo tài chính minh bạch</span></li>
				<li><strong>Phòng ngừa</strong><span>Bảo trì theo lịch, không chờ hỏng</span></li>
			</ul>
		</div>
	</section>

	<section id="dich-vu" class="section">
		<div class="container">
			<header class="section-head">
				<p class="eyebrow">Dịch vụ</p>
				<h2>Một đầu mối cho toàn bộ vòng đời tòa nhà</h2>
				<p>Chọn gói tổng thể hoặc từng mảng riêng, đều theo cùng một bộ tiêu chuẩn.</p>
			</header>
			<div class="grid grid-4">
				{
					services.map((s, i) => (
						<article class="card">
							<div class="card-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="tieu-chuan" class="section section-soft">
		<div class="container">
			<header class="section-head">
				<p class="eyebrow">Tiêu chuẩn</p>
				<h2>HADREAMCO đề xuất các tiêu chuẩn tốt nhất áp dụng cho các bất động sản tại Việt Nam</h2>
				<p>
					Chúng tôi học cách làm của các tập đoàn quản lý bất động sản hàng đầu tại Mỹ và Nhật Bản,
					rồi điều chỉnh cho phù hợp pháp luật và thói quen sử dụng trong nước.
				</p>
			</header>
			<div class="grid grid-2">
				<article class="standard">
					<span class="tag">Chuẩn Mỹ</span>
					<h3>Minh bạch và đo lường được</h3>
					<p>Tòa nhà là một tài sản đầu tư. Mọi quyết định vận hành đều phải trả lời được bằng số liệu.</p>
					<ul>{usStandards.map((i) => <li>{i}</li>)}</ul>
				</article>
				<article class="standard">
					<span class="tag">Chuẩn Nhật</span>
					<h3>Tỉ mỉ và bền bỉ</h3>
					<p>Chất lượng nằm ở những việc nhỏ làm đều mỗi ngày, kể cả ở nơi không ai nhìn thấy.</p>
					<ul>{jpStandards.map((i) => <li>{i}</li>)}</ul>
				</article>
			</div>
		</div>
	</section>

	<section id="loai-hinh" class="section">
		<div class="container">
			<header class="section-head">
				<p class="eyebrow">Loại hình</p>
				<h2>Phù hợp với nhiều loại công trình</h2>
			</header>
			<div class="grid grid-3">
				{
					propertyTypes.map((p) => (
						<article class="card card-line">
							<h3>{p.title}</h3>
							<p>{p.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="quy-trinh" class="section section-green">
		<div class="container">
			<header class="section-head">
				<p class="eyebrow">Quy trình</p>
				<h2>Năm bước từ khảo sát đến vận hành ổn định</h2>
			</header>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li>
							<span class="step-no">{String(i + 1).padStart(2, '0')}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="hoi-dap" class="section">
		<div class="container narrow">
			<header class="section-head">
				<p class="eyebrow">Hỏi đáp</p>
				<h2>Những câu hỏi thường gặp</h2>
			</header>
			{
				faqs.map((f) => (
					<details class="faq">
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<section id="lien-he" class="section section-soft">
		<div class="container grid grid-2 contact">
			<div>
				<p class="eyebrow">Liên hệ</p>
				<h2>Nhận khảo sát và đề xuất vận hành cho tòa nhà của bạn</h2>
				<p>
					Để lại thông tin, chuyên viên sẽ liên hệ để hẹn lịch khảo sát. Khảo sát và đề xuất ban đầu
					không tính phí.
				</p>
				<ul class="contact-list">
					{site.phone && <li><strong>Hotline:</strong> <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>}
					{site.email && <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>}
					{site.address && <li><strong>Địa chỉ:</strong> {site.address}</li>}
					<li>{site.hours}</li>
				</ul>
			</div>
			<form class="form" id="contact-form" data-email={site.email}>
				<label>Họ và tên<input name="name" type="text" autocomplete="name" required /></label>
				<label>Số điện thoại<input name="phone" type="tel" autocomplete="tel" required /></label>
				<label>
					Loại công trình
					<select name="type">
						{propertyTypes.map((p) => <option>{p.title}</option>)}
						<option>Khác</option>
					</select>
				</label>
				<label>Nội dung cần tư vấn<textarea name="message" rows="4"></textarea></label>
				<button class="btn btn-primary" type="submit">Gửi yêu cầu</button>
				<p class="form-note">Bấm gửi sẽ mở ứng dụng email của bạn với nội dung đã điền sẵn.</p>
			</form>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const body = [
			`Họ tên: ${data.get('name')}`,
			`Điện thoại: ${data.get('phone')}`,
			`Loại công trình: ${data.get('type')}`,
			'',
			`${data.get('message') ?? ''}`,
		].join('\n');
		const subject = `Yêu cầu tư vấn quản lý tòa nhà - ${data.get('name')}`;
		window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	});
</script>

<style>
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--green-600);
		margin-bottom: 10px;
	}
	.hero {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, var(--green-900) 0%, var(--green-700) 55%, var(--green-600) 100%);
		color: #e4f1e2;
		padding: 96px 0 72px;
	}
	.hero-inner {
		position: relative;
		z-index: 1;
	}
	@media (min-width: 1081px) {
		.hero-inner > :not(.hero-points) {
			max-width: 640px;
		}
	}
	/* Họa tiết hình tròn theo phong cách hồ sơ năng lực */
	.hero-art {
		position: absolute;
		top: 50%;
		right: max(24px, calc((100vw - 1140px) / 2));
		width: 380px;
		height: 380px;
		transform: translateY(-58%);
	}
	.hero-art img {
		position: absolute;
		inset: 40px;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		border: 8px solid #fff;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
	}
	.ring {
		position: absolute;
		border-radius: 50%;
		border: 2px solid var(--lime);
	}
	.ring-1 {
		inset: 0;
		opacity: 0.8;
	}
	.ring-2 {
		inset: -70px;
		border-color: rgba(255, 255, 255, 0.16);
	}
	.dot {
		position: absolute;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		background: var(--lime);
		right: -6px;
		bottom: 48px;
	}
	.hero .eyebrow {
		color: var(--lime);
	}
	.hero h1 {
		color: #fff;
		font-size: clamp(2rem, 4.2vw, 3.2rem);
		max-width: 17ch;
	}
	.lead {
		font-size: 1.15rem;
		max-width: 60ch;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin: 28px 0 56px;
	}
	.hero-points {
		list-style: none;
		padding: 28px 0 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
	}
	.hero-points strong {
		display: block;
		color: var(--lime-soft);
		font-size: 1.35rem;
	}
	.hero-points span {
		font-size: 0.92rem;
	}
	.section {
		padding: 84px 0;
	}
	.section-soft {
		background: var(--bg-soft);
	}
	.section-green {
		background: linear-gradient(135deg, var(--green-700), var(--green-900));
		color: #d9ead9;
	}
	.section-green h2,
	.section-green h3 {
		color: #fff;
	}
	.section-green .eyebrow {
		color: var(--lime);
	}
	.section-head {
		max-width: 720px;
		margin-bottom: 44px;
	}
	.section-head h2,
	.contact h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}
	.section-head p:last-child {
		color: var(--muted);
		margin: 0;
	}
	.grid {
		display: grid;
		gap: 24px;
	}
	.grid-2 {
		grid-template-columns: repeat(2, 1fr);
	}
	.grid-3 {
		grid-template-columns: repeat(3, 1fr);
	}
	.grid-4 {
		grid-template-columns: repeat(4, 1fr);
	}
	.card {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 26px 22px;
		transition: box-shadow 0.15s, transform 0.15s;
	}
	.card:hover {
		box-shadow: 0 12px 30px rgba(16, 106, 57, 0.14);
		border-color: var(--lime);
		transform: translateY(-2px);
	}
	.card h3 {
		font-size: 1.08rem;
	}
	.card p {
		color: var(--muted);
		font-size: 0.95rem;
		margin: 0;
	}
	.card-no {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: 1.1rem;
		color: #fff;
		background: linear-gradient(160deg, var(--green-500), var(--green-700));
		box-shadow: 0 0 0 5px rgba(151, 203, 103, 0.28);
		margin-bottom: 18px;
	}
	.grid-4 .card:nth-child(even) .card-no {
		background: linear-gradient(160deg, var(--green-600), var(--green-900));
	}
	.card-line {
		border-left: 4px solid var(--lime);
	}
	.standard {
		background: #fff;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		padding: 34px 30px;
	}
	.tag {
		display: inline-block;
		background: var(--green-700);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 5px 12px;
		border-radius: 999px;
		margin-bottom: 14px;
	}
	.standard ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.standard li {
